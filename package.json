{
  "name": "dwellio-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Dwellio - Your Home, in Good Hands.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend\"",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/backend && npm run build --workspace=apps/frontend",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=apps/backend && npm run test --workspace=apps/frontend",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "vitest run tests/e2e/smoke.test.ts",
    "test:e2e:journeys": "vitest run tests/e2e/userJourneys.test.ts",
    "test:redis-integration": "npm run test:redis-integration --workspace=apps/backend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed:admin": "npm run seed:admin --workspace=apps/backend",
    "seed:catalog": "npm run seed:catalog --workspace=apps/backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2"
  }
}
