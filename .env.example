# Dwellio Monorepo Root Environment Configuration (Template)
# See apps/backend/.env.example and apps/frontend/.env.example for workspace-specific variables.

# Backend Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/dwellio
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Settings
VITE_API_BASE_URL=http://localhost:5000/api
