# ==============================================================================
# Dwellio Monorepo Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose or local development:
#   cp .env.example .env
#
# IMPORTANT:
# - In production, JWT_SECRET MUST be set to a cryptographically secure string (min 32 chars).
# - MONGO_URI in Docker Compose uses the container hostname 'mongodb':
#     MONGO_URI=mongodb://mongodb:27017/dwellio
# - For local development without Docker, use localhost:
#     MONGO_URI=mongodb://localhost:27017/dwellio

# Server Environment
NODE_ENV=production
PORT=5000
FRONTEND_PORT=80

# Networking & Security
CLIENT_URL=http://localhost
JWT_SECRET=replace_with_a_secure_production_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Configuration
MONGO_URI=mongodb://mongodb:27017/dwellio
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=2

# Rate Limiting Quotas (per 15-minute window)
API_RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30
BOOKING_RATE_LIMIT_MAX=15
CATALOG_RATE_LIMIT_MAX=200
NOTIFICATION_RATE_LIMIT_MAX=150

# Frontend Configuration (Used when overriding reverse proxy relative /api fallback)
# VITE_API_BASE_URL=http://localhost:5000/api
