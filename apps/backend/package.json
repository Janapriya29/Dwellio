{
  "name": "dwellio-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:redis-integration": "node -e \"process.env.RUN_REDIS_INTEGRATION='true'; require('child_process').execSync('npx vitest run tests/redis.bullmq.integration.test.ts', { stdio: 'inherit', env: { ...process.env, RUN_REDIS_INTEGRATION: 'true' } });\"",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:catalog": "tsx src/scripts/seedCatalog.ts"
  },
  "dependencies": {
    "@dwellio/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  }
}
